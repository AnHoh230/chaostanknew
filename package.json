{
  "name": "chaostanknew",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:catalog": "vite-node tools/exportAssetCatalog.ts",
    "assets:audit": "vite-node tools/auditAssetSeeds.ts",
    "assets:preview": "vite-node tools/renderIronwasteSeedBoard.ts",
    "assets:lab": "vite --open /asset-lab.html",
    "assets:generate": "npm run assets:catalog && node tools/generateIronwasteAssets.mjs && npm run assets:preview",
    "assets:verify": "node tools/verifyIronwasteAssets.mjs",
    "assets:approve": "node tools/verifyIronwasteAssets.mjs --approve"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
